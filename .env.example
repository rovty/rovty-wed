# Public browser configuration for the Wed Supabase project.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values. Never prefix service credentials with VITE_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
WED_WORKER_SECRET=replace-with-a-new-random-wed-only-secret
# WED_WORKER_SECRET must match the dashboard Worker. Use Cloudflare secrets
# in production. See docs/platform-identity.md for rollout and rotation.
# Legacy rollout only: TEAM_GRANT_SHARED_SECRET=old-key

# Public navigation and server-to-server connection for separate Workers.
# Override all three for local/staging environments.
VITE_ROVTY_DASHBOARD_ORIGIN=https://dash.rovty.com
VITE_ROVTY_SITE_ORIGIN=https://rovty.com
ROVTY_DASHBOARD_ORIGIN=https://dash.rovty.com
# Old DASHBOARD_SSO_RESOLVE_URL / DASHBOARD_PRODUCT_ACCESS_GRANT_URL overrides
# are supported during transition; remove them to use the origin above.
