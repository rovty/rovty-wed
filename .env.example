# Copy to .env and fill in this project's own Supabase values (Project
# Settings → API). The service_role key is required (src/routes/sso.ts and
# client.server.ts use it) — do not expose it client-side, it's read via
# process.env, never import.meta.env.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Where to redeem an incoming SSO hand-off token (src/routes/sso.ts) — the
# dashboard Worker's /api/sso/resolve. Defaults to production if unset;
# override for local testing against a local dashboard dev server.
# DASHBOARD_SSO_RESOLVE_URL=https://dash.rovty.com/api/sso/resolve

# Presented to the dashboard Worker's /api/product-access/grant (see
# src/routes/api.team.ts) when a wedding invite is accepted, so the invited
# person's dashboard account gets Rovty Wed unlocked too — must match the
# dashboard's own TEAM_GRANT_SHARED_SECRET exactly. Generate with
# `openssl rand -hex 32`; set via `wrangler secret put TEAM_GRANT_SHARED_SECRET`
# in production.
TEAM_GRANT_SHARED_SECRET=replace-with-a-long-random-secret

# Where to grant dashboard product access (src/routes/api.team.ts) — the
# dashboard Worker's /api/product-access/grant. Defaults to production if
# unset; override for local testing against a local dashboard dev server.
# DASHBOARD_PRODUCT_ACCESS_GRANT_URL=https://dash.rovty.com/api/product-access/grant
